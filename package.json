{
  "name": "casaora",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "node --experimental-strip-types --test src/lib/property-filters.test.mjs src/lib/property-search.test.mjs",
    "test:http": "node --test scripts/property-route-http.test.mjs",
    "test:ui-contracts": "node --test scripts/ui-contracts.test.mjs",
    "test:browser": "node --test scripts/property-discovery-browser.test.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "test:db-migrations": "node --test scripts/db-migrations.test.mjs scripts/db-migration-contract.test.mjs scripts/db-migration-errors.test.mjs scripts/db-migration-database-creation.test.mjs scripts/db-migration-fixture-cleanup.test.mjs",
    "test:db-migrations:integration": "node --test scripts/db-migrations.integration.test.mjs",
    "test:db-schema:integration": "node --test scripts/db-schema.integration.test.mjs",
    "test:regression": "npm test && npm run test:db-migrations && npm run test:db-migrations:integration && npm run test:db-schema:integration && npm run test:http && npm run test:ui-contracts && npm run test:browser"
  },
  "dependencies": {
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
